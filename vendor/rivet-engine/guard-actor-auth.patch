+// Private local runtimes use the same configured authority as public management.
+// Check it before resolving a query: resolution can create a durable actor.
+fn authenticate_actor_gateway(ctx: &StandaloneCtx, token: Option<&str>) -> Result<()> {
+	let Some(auth) = &ctx.config().auth else {
+		return Ok(());
+	};
+	let Some(token) = token else {
+		return Err(rivet_api_builder::ApiForbidden.build());
+	};
+	if token.as_bytes().ct_ne(auth.admin_token.read().as_bytes()).into() {
+		return Err(rivet_api_builder::ApiForbidden.build());
+	}
+	Ok(())
+}

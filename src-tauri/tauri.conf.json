{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.1.0",
  "identifier": "com.bridgehammer.lumen",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run stage:sidecars && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumen",
        "width": 700,
        "height": 66,
        "minWidth": 620,
        "maxWidth": 760,
        "minHeight": 66,
        "maxHeight": 66,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": ["acrylic", "mica", "blur"],
          "color": "#0a121bc4"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' http://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' http://localhost:1420; script-src 'self' 'unsafe-eval' http://localhost:1420; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/agentgateway", "binaries/cliproxy-sidecar", "binaries/lumen-enrichment", "binaries/lumen-rivet-engine", "binaries/lumen-computer-use"],
    "resources": {
      "binaries/libstdc++-6.dll": "libstdc++-6.dll",
      "binaries/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "binaries/libwinpthread-1.dll": "libwinpthread-1.dll",
      "binaries/vector.dll": "vector.dll",
      "binaries/windows-ai/": "windows-ai/",
      "binaries/computer-use-runtime/": "computer-use-runtime/",
      "resources/improvement/": "improvement-runtime/",
      "../packaging/windows/Assets/": "Assets/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources><clear /><add key="nuget.org" value="https://api.nuget.org/v3/index.json" /><add key="aion-pinned" value=".nuget" /></packageSources>
  <packageSourceMapping>
    <packageSource key="aion-pinned"><package pattern="AionInstructPreview.Text.Framework" /></packageSource>
    <packageSource key="nuget.org"><package pattern="Microsoft.*" /><package pattern="System.*" /><package pattern="runtime.*" /><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
